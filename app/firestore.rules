rules_version = '2';

// Reglas de seguridad de Firestore — Tecnología Importada
// Modelo: SIN roles. Cualquier usuario autenticado (equipo) tiene acceso completo.
// El público (anónimo) solo puede leer el catálogo y crear pedidos (leads).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validateVentaCliente(cliente) {
      // Si cliente existe, validar que solo tiene campos permitidos
      return !cliente.keys().hasAny(['nombreBusqueda']) &&
             (!cliente.keys().hasAny(['cuitDni', 'celular', 'nombre']) ||
              cliente.keys().hasOnly(['cuitDni', 'celular', 'nombre']));
    }

    // Catálogo: lectura pública, escritura solo equipo
    match /products/{id} {
      allow read: if true;
      allow write: if signedIn();
      match /variants/{vid} {
        allow read: if true;
        allow write: if signedIn();
      }
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /novedades/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Pedidos (consultas de carrito): el público puede CREAR su consulta,
    // solo el equipo lee/edita.
    match /pedidos/{id} {
      allow create: if request.resource.data.keys().hasAll(['nombre', 'celular', 'items', 'estado', 'creado'])
                    && request.resource.data.estado == 'nuevo'
                    && request.resource.data.nombre is string
                    && request.resource.data.celular is string;
      allow read, update, delete: if signedIn();
    }

    // Datos internos del negocio: solo equipo (autenticado)
    // Ventas con validación de schema para cliente object
    match /ventas/{id} {
      allow create, update: if signedIn() && validateVentaCliente(request.resource.data.get('cliente', {}));
      allow read, delete: if signedIn();
    }
    match /regalos/{id}           { allow read, write: if signedIn(); }
    match /cuentasCobrar/{id}     { allow read, write: if signedIn(); }
    match /gastos/{id}            { allow read, write: if signedIn(); }
    match /movimientosStock/{id}  { allow read, write: if signedIn(); }
    match /stockBajo/{id}         { allow read, write: if signedIn(); }
    match /importBatches/{id}     { allow read, write: if signedIn(); }
    match /counters/{id}          { allow read, write: if signedIn(); }
    match /balances/{id}          { allow read, write: if signedIn(); }
    match /settings/{id}          { allow read: if true; allow write: if signedIn(); }
    match /contactosAdmin/{id}    { allow read, write: if signedIn(); }
    match /clientes/{id} {
      // Lectura: solo autenticados
      allow read: if signedIn();
      
      // Creación: solo admin O público con datos válidos
      allow create: if signedIn() || (
        request.resource.data.keys().hasOnly([
        'celular', 'nombre', 'nombreOriginal', 'nombreBusqueda',
        'cantidadPedidos', 'cantidadVentas', 'cantidadCuentas',
        'ultimoContacto', 'eliminado', 'actualizadoEn'
        ])
        && request.resource.data.celular == id
        && request.resource.data.nombre is string
        && request.resource.data.celular is string
        && request.resource.data.eliminado == false
      );
      
      // Actualización y eliminación: solo admin (autenticado)
      allow update, delete: if signedIn();
    }
    match /clientesMeta/{id} { allow read, write: if signedIn(); }
  }
}
